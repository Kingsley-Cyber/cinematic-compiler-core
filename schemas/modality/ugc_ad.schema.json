{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:modality:ugc_ad:1.0",
  "title": "Modality: ugc_ad",
  "description": "UGC ad: hands-and-product framing; the product must visibly work. Hand roles stay locked through each interaction; every functional verb shows its before and after state. Applies to a complete envelope; scene.fps.default is the genre fps used when the query gives none (marked fps_source: default); scene.duration_s.default is the planning budget S04 uses when the query gives no duration (draft value).",
  "type": "object",
  "properties": {
    "scene": {
      "type": "object",
      "required": [
        "genre"
      ],
      "properties": {
        "genre": {
          "const": "ugc_ad"
        },
        "fps": {
          "type": "number",
          "default": 30
        },
        "duration_s": {
          "type": "number",
          "default": 15
        }
      }
    },
    "nodes": {
      "type": "object",
      "required": [
        "hand_role",
        "object_state",
        "affordance"
      ],
      "properties": {
        "hand_role": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "object_state": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "affordance": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    }
  },
  "required": [
    "scene"
  ]
}
