{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:beat:1.3",
  "title": "Beat (shared definition)",
  "description": "One timed event of a scene with its actor, participants, positions, facings, requirements, effects, contacts, causes and prop samples (S04). Shared by the beat plan and the temporal graph (owner O65); Contact is embedded from contact.schema.json by kernel/shared_schemas.py.",
  "$defs": {
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "prop",
            "surface"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "Vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "property",
        "value"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/Ref"
        },
        "property": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "property",
        "value"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/Ref"
        },
        "property": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "enum": [
            "start",
            "end"
          ],
          "description": "When the change takes effect inside its beat: at its start, or (the default) at its end; a change of hands takes effect at its possess or release (F-061). RV-07, O91."
        }
      }
    },
    "Contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_type",
        "a",
        "b"
      ],
      "properties": {
        "contact_type": {
          "enum": [
            "touch",
            "possess",
            "support",
            "release"
          ]
        },
        "a": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "part"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "part": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "part"
          ],
          "properties": {
            "kind": {
              "enum": [
                "entity",
                "prop",
                "surface"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "part": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "at": {
          "enum": [
            "start",
            "end"
          ],
          "description": "When the contact happens in its beat: at the beat's end (default) or its start (e.g. a prop already in hand at t=0, M8.12)."
        },
        "verb": {
          "enum": [
            "strike",
            "deflect",
            "parry",
            "catch",
            "redirect",
            "trap",
            "bind",
            "disarm",
            "throw",
            "grapple"
          ],
          "description": "Owner O22 (plan F4.1): the combat action the contact performs; which contact type takes which verb is library/combat_verbs.yaml."
        }
      }
    },
    "Cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "causal_strength",
        "why"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^b[0-9]{2,3}$"
        },
        "causal_strength": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "t",
        "dur",
        "event_type",
        "actor",
        "label",
        "participants",
        "modes",
        "pos",
        "facing",
        "action",
        "requires",
        "effects",
        "contacts",
        "causes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]{2,3}$"
        },
        "t": {
          "type": "number",
          "minimum": 0
        },
        "dur": {
          "type": "number",
          "minimum": 0
        },
        "event_type": {
          "enum": [
            "action",
            "hold",
            "transition",
            "substitution"
          ]
        },
        "actor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "pos": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Vec3"
          }
        },
        "facing": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Vec3"
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contact"
          }
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cause"
          }
        },
        "prop_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropSample"
          }
        }
      }
    },
    "PropSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop",
        "t",
        "p",
        "v",
        "float"
      ],
      "description": "Owner O8: a prop's position (and velocity at throws, releases, deflects) at time t inside the beat; metres and metres per second in the scene frame; v null while held; float true marks a stylised anime float (no gravity).",
      "properties": {
        "prop": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "t": {
          "type": "number",
          "minimum": 0
        },
        "p": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "v": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "float": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "pre",
            "post"
          ],
          "description": "F2.2: at a contact on the prop, the sample just before (pre) or just after (post) it; a pair shares t and p, and a free prop moving into a contact needs one."
        }
      }
    }
  },
  "$ref": "#/$defs/Beat"
}
