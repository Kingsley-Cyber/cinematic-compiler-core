{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:world_card:1.1",
  "title": "World card (setting, axes and surfaces; L0.5 scene and surfaces)",
  "description": "Library concept card. Draft cards are owner-reviewable data, not research claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "kind",
    "card_version",
    "status",
    "names",
    "description",
    "match_terms",
    "genres",
    "ax",
    "surfaces",
    "invariants",
    "provenance"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Lowercase names and aliases a query hint may match exactly (or as its trailing words)."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "date",
        "basis"
      ],
      "properties": {
        "authored_by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind": {
      "const": "world"
    },
    "match_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+$"
      }
    },
    "genres": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "live_action",
          "anime",
          "ugc_ad"
        ]
      }
    },
    "ax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "up",
        "forward",
        "ground",
        "unit"
      ],
      "properties": {
        "up": {
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ]
        },
        "forward": {
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ]
        },
        "ground": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "m",
            "scene_unit"
          ]
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "boxes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "floor",
              "wall",
              "boundary",
              "obstacle",
              "tabletop",
              "backdrop"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "description": "Where the surface is (R20 next action 2): one or more axis-aligned boxes in scene metres, {min: [x, y, z], max: [x, y, z]}; a floor's top is its highest max y. Several boxes for a surface in pieces (a boundary on four sides).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "max": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "ax": {
            "type": "string",
            "minLength": 1,
            "description": "Geometry statement printed in the render's ax line."
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "Words that must all appear in the query for this world to match; each adds one to its score."
    },
    "negatives": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Render negatives this card adds (printed in the negative section)."
    }
  }
}
