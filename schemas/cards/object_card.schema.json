{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:object_card:1.0",
  "title": "Object card (prop ontology; L0.5 props, later L2.6 object state and L2.7 affordances)",
  "description": "Library concept card. Draft cards are owner-reviewable data, not research claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "kind",
    "card_version",
    "status",
    "names",
    "description",
    "parts",
    "materials",
    "states",
    "affordances",
    "grips",
    "provenance"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Lowercase names and aliases a query hint may match exactly (or as its trailing words)."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "date",
        "basis"
      ],
      "properties": {
        "authored_by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind": {
      "const": "object"
    },
    "parts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "materials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "property",
          "values"
        ],
        "properties": {
          "property": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "affordances": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "grips": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
