{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:camera_idiom_card:1.1",
  "title": "Camera idiom card (S16, per archetype)",
  "description": "Informational coverage preferences for an archetype, shown to the camera author (not enforced).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "card_version",
    "status",
    "kind",
    "archetype",
    "idioms",
    "provenance"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "kind": {
      "const": "camera_idiom"
    },
    "archetype": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "idioms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "prefer",
          "trigger",
          "asks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "prefer": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "enum": [
              "opening",
              "any_cut",
              "hit",
              "fast_move",
              "heavy_move",
              "turn",
              "airborne",
              "landing",
              "flight",
              "appearance",
              "cast",
              "ward",
              "product_use",
              "talking_to_camera"
            ],
            "description": "When the rule applies (F-177, RV-71b)."
          },
          "asks": {
            "type": "object",
            "additionalProperties": false,
            "description": "F-177 (RV-71b): what the rule asks of the shot, in the grammar's words; planner/camera_library.py checks it (a hit rule is a static hold on every body present at an impact scale, owner O92).",
            "properties": {
              "scale": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "movement": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "playback": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "subjects": {
                "enum": [
                  "all_present",
                  "actor",
                  "detail",
                  "hand_and_object",
                  "speaker"
                ]
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "date",
        "basis"
      ],
      "properties": {
        "authored_by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
