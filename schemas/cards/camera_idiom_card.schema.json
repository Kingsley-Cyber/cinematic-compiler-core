{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:camera_idiom_card:1.0",
  "title": "Camera idiom card (S16, per archetype)",
  "description": "Informational coverage preferences for an archetype, shown to the camera author (not enforced).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "card_version",
    "status",
    "kind",
    "archetype",
    "idioms",
    "provenance"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "kind": {
      "const": "camera_idiom"
    },
    "archetype": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "idioms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "prefer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "prefer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "date",
        "basis"
      ],
      "properties": {
        "authored_by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
