{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:archetype_card:1.3",
  "title": "Archetype card (character definition; L0.5 entities)",
  "description": "Library concept card. Draft cards are owner-reviewable data, not research claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "kind",
    "card_version",
    "status",
    "names",
    "description",
    "silhouette",
    "costume",
    "parts",
    "capabilities",
    "modes",
    "genres",
    "invariants",
    "provenance"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Lowercase names and aliases a query hint may match exactly (or as its trailing words)."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "date",
        "basis"
      ],
      "properties": {
        "authored_by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind": {
      "const": "archetype"
    },
    "silhouette": {
      "type": "string",
      "minLength": 1
    },
    "costume": {
      "type": "string",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "genres": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "live_action",
          "anime",
          "ugc_ad"
        ]
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "requires_prop": {
            "type": "string",
            "pattern": "^(any|[a-z][a-z0-9_]*)$",
            "description": "The rule applies only when the scene holds this prop (an object card id), or some prop (`any`); S03 leaves it out otherwise (R20: a thrown-weapon rule with no weapon in the scene invited one)."
          }
        }
      }
    },
    "negatives": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Render negatives this card adds (printed in the negative section)."
    },
    "equipment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "Object card ids this archetype carries into a scene as props (S02, source card)."
    },
    "camera_idioms": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "The camera idiom card (library/camera_idioms/<id>.yaml) this archetype's shots draw on when it is not the archetype's own id (F-177, RV-71a)."
    },
    "face_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_regions",
        "dominant_side",
        "emotional_range",
        "resting"
      ],
      "properties": {
        "visible_regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "brows",
              "eyes",
              "cheeks",
              "nose",
              "mouth",
              "jaw"
            ]
          }
        },
        "dominant_side": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        },
        "emotional_range": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "neutral",
              "joy",
              "interest",
              "surprise",
              "anger",
              "fear",
              "sadness",
              "disgust",
              "contempt"
            ]
          }
        },
        "resting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valence",
            "arousal"
          ],
          "properties": {
            "valence": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "arousal": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        }
      },
      "description": "S15 facial: which face regions the costume leaves visible, the side that leads asymmetric expressions, the emotion families the archetype shows and its resting valence/arousal (-1..1)."
    }
  }
}
