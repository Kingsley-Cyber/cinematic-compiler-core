{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:camera_grammar:1.0",
  "title": "Camera grammar (S16, L5.5)",
  "description": "Geometry constants, scale bands, what a scale shows, rig limits, the cut-angle rule and intent requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grammar_id",
    "version",
    "status",
    "basis",
    "aim_height_m",
    "sensor_mm",
    "on_axis_m",
    "min_cut_angle_deg",
    "scale_frame_height_m",
    "visible_parts",
    "lens_perspective_mm",
    "rig_movements",
    "rig_stability",
    "intents",
    "frontal_deg"
  ],
  "properties": {
    "grammar_id": {
      "const": "camera_grammar"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "aim_height_m": {
      "type": "number",
      "minimum": 0
    },
    "sensor_mm": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 1
      }
    },
    "on_axis_m": {
      "type": "number",
      "minimum": 0
    },
    "min_cut_angle_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 180
    },
    "scale_frame_height_m": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "visible_parts": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "lens_perspective_mm": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "rig_movements": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "rig_stability": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "intents": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "not_in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "frontal_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90,
      "description": "S16 face checks: a camera within this angle of the face sees both sides."
    }
  }
}
