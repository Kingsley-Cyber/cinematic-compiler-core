{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:camera_convention_card:1.1",
  "title": "Camera convention card (S16, per genre)",
  "description": "What a genre's coverage allows; conventions are the ids a genre_convention motivation names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "card_version",
    "status",
    "kind",
    "genre",
    "description",
    "transitions",
    "playback",
    "rigs",
    "max_roll_deg",
    "shot_duration_s",
    "cross_line",
    "required_intents",
    "conventions",
    "provenance"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "kind": {
      "const": "camera_convention"
    },
    "genre": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "transitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "playback": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "rigs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "max_roll_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "shot_duration_s": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "cross_line": {
      "enum": [
        "allowed",
        "forbidden"
      ]
    },
    "required_intents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "trigger",
          "asks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "enum": [
              "opening",
              "any_cut",
              "hit",
              "fast_move",
              "heavy_move",
              "turn",
              "airborne",
              "landing",
              "flight",
              "appearance",
              "cast",
              "ward",
              "product_use",
              "talking_to_camera"
            ],
            "description": "When the rule applies (F-177, RV-71b)."
          },
          "asks": {
            "type": "object",
            "additionalProperties": false,
            "description": "F-177 (RV-71b): what the rule asks of the shot, in the grammar's words; planner/camera_library.py checks it (a hit rule is a static hold on every body present at an impact scale, owner O92).",
            "properties": {
              "scale": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "movement": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "playback": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "subjects": {
                "enum": [
                  "all_present",
                  "actor",
                  "detail",
                  "hand_and_object",
                  "speaker"
                ]
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "date",
        "basis"
      ],
      "properties": {
        "authored_by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
