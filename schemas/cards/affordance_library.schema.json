{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:affordance_library:1.0",
  "title": "Affordance library (S10)",
  "description": "(object, action) entries: object-state preconditions and postconditions (any listed value), the grip the agent hand needs and the duration range. card: pending marks an object with no card yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library_id",
    "category",
    "version",
    "status",
    "basis",
    "entries"
  ],
  "properties": {
    "library_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "category": {
      "enum": [
        "clothing",
        "food",
        "electronics",
        "cosmetics"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "card",
          "action",
          "preconditions",
          "postconditions",
          "required_grip",
          "duration_s"
        ],
        "properties": {
          "object": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "card": {
            "enum": [
              "present",
              "pending"
            ]
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "values"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "values"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "required_grip": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "duration_s": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
