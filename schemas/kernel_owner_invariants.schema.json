{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:kernel_owner_invariants:1.0",
  "title": "Owner-authored kernel invariants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "band",
          "statement",
          "check",
          "layer",
          "learned_from",
          "kernel_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "band": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "learned_from": {
            "type": "string",
            "minLength": 1
          },
          "kernel_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
