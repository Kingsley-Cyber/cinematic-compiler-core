    "Intent": {
      "title": "Intent Document (S01, band L0)",
      "description": "Embedded from schemas/intent_document.schema.json. Literal extraction from the user query and CLI flags. Every parsed value is backed by evidence (a query span or a flag); every unextracted field is named in `missing`. Embedded in the envelope at /intent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "band",
        "raw_query",
        "flags",
        "parsed",
        "evidence",
        "missing",
        "ambiguous",
        "confidence"
      ],
      "properties": {
        "step_id": {
          "const": "S01"
        },
        "band": {
          "const": "L0"
        },
        "raw_query": {
          "type": "string"
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "genre",
            "duration_s"
          ],
          "properties": {
            "genre": {
              "enum": [
                null,
                "live_action",
                "anime",
                "ugc_ad"
              ]
            },
            "duration_s": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          }
        },
        "parsed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_s",
            "fps",
            "genre",
            "setting",
            "entities_hinted",
            "props_hinted",
            "style_reference"
          ],
          "properties": {
            "duration_s": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "fps": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "genre": {
              "enum": [
                null,
                "live_action",
                "anime",
                "ugc_ad"
              ]
            },
            "setting": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "entities_hinted": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "props_hinted": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "style_reference": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duration_s": {
              "$ref": "#/$defs/Intent_EvidenceList"
            },
            "fps": {
              "$ref": "#/$defs/Intent_EvidenceList"
            },
            "genre": {
              "$ref": "#/$defs/Intent_EvidenceList"
            },
            "setting": {
              "$ref": "#/$defs/Intent_EvidenceList"
            },
            "entities_hinted": {
              "$ref": "#/$defs/Intent_EvidenceList"
            },
            "props_hinted": {
              "$ref": "#/$defs/Intent_EvidenceList"
            },
            "style_reference": {
              "$ref": "#/$defs/Intent_EvidenceList"
            }
          }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "duration_s",
              "fps",
              "genre",
              "setting",
              "entities",
              "props",
              "style_reference",
              "choreography",
              "camera_plan",
              "geometry_anchors"
            ]
          }
        },
        "ambiguous": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Intent_Ambiguity"
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "Intent_Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "query",
            "flag"
          ]
        },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "properties": {
            "source": {
              "const": "query"
            }
          },
          "required": [
            "span",
            "text"
          ]
        },
        {
          "properties": {
            "source": {
              "const": "flag"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "span"
                ]
              },
              {
                "required": [
                  "text"
                ]
              }
            ]
          }
        }
      ]
    },
    "Intent_EvidenceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Intent_Evidence"
      }
    },
    "Intent_Ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "candidates",
        "reason"
      ],
      "properties": {
        "field": {
