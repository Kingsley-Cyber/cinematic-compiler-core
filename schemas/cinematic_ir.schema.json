            "genre",
            "setting",
            "entities_hinted",
            "props_hinted",
            "style_reference"
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Intent_Evidence"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Scene": {
      "type": "object",
      "additionalProperties": false,
      "description": "Written by S02. A null value is listed in `missing`; every value names its source.",
      "required": [
        "duration_s",
        "fps",
        "genre",
        "world",
        "setting",
        "style_reference",
        "ax",
        "sources",
        "missing",
        "ambiguous",
        "unresolved_hints"
      ],
      "properties": {
        "duration_s": {
