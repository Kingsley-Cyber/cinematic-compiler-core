{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:rules:1.0",
  "title": "Rulebook (docs/rules.yaml)",
  "description": "The canonical rules: each with a scope, the accepted decisions it comes from and what enforces it (owner O64, O65). docs/rules.md is generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "source",
          "rule",
          "enforced_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[0-9]{2}$"
          },
          "scope": {
            "enum": [
              "agent",
              "compiler",
              "prompt",
              "owner"
            ]
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ADR-[A-Z][0-9]+$"
            }
          },
          "rule": {
            "type": "string",
            "minLength": 10
          },
          "enforced_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
