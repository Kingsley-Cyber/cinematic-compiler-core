{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:motion_plan:2.2",
  "title": "S13 motion plan (authored in-session): one Euler key pose per entity per beat, and in-between keys",
  "description": "Root pos equals the S04 anchor; rot agrees with the S04 facing; bones are the kernel joints; turns declare their axis (flip X, spin Y, cartwheel Z). An in-between key (ADR-O109) is one entity's pose at an instant strictly between two of its consecutive keys, on a frame of its own, with no beat, contact or anchor; S13 checks it like a key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "keys"
  ],
  "properties": {
    "step_id": {
      "const": "S13"
    },
    "band": {
      "const": "L4c"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "name",
          "pos",
          "rot",
          "turn",
          "axis_declaration",
          "description"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rot": {
            "$ref": "#/$defs/EulerXYZ"
          },
          "bones": {
            "type": "object",
            "patternProperties": {
              "^[A-Z][A-Za-z]*$": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "description": "Local joint Euler degrees relative to the rest pose, same convention as the root."
              }
            },
            "additionalProperties": false
          },
          "turn": {
            "$ref": "#/$defs/Turn"
          },
          "axis_declaration": {
            "$ref": "#/$defs/AxisDeclaration"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "words": {
            "$ref": "#/$defs/PoseWords"
          }
        },
        "anyOf": [
          {
            "required": [
              "bones"
            ]
          },
          {
            "required": [
              "words"
            ]
          }
        ]
      }
    },
    "inbetweens": {
      "type": "array",
      "description": "ADR-O109 (RV-59f): poses between two of one entity's keys, placed by the repo where the declared interpolation would draw a body through another or under the floor.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "t",
          "name",
          "pos",
          "rot",
          "description"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rot": {
            "$ref": "#/$defs/EulerXYZ"
          },
          "bones": {
            "type": "object",
            "patternProperties": {
              "^[A-Z][A-Za-z]*$": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "description": "Local joint Euler degrees relative to the rest pose, same convention as the root."
              }
            },
            "additionalProperties": false
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "words": {
            "$ref": "#/$defs/PoseWords"
          }
        },
        "anyOf": [
          {
            "required": [
              "bones"
            ]
          },
          {
            "required": [
              "words"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "EulerXYZ": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1080,
        "maximum": 1080
      },
      "description": "Root Euler degrees [X, Y, Z], intrinsic XYZ, right-handed; continuous per entity (never wrapped)."
    },
    "Turn": {
      "enum": [
        "none",
        "flip",
        "spin",
        "cartwheel"
      ]
    },
    "AxisDeclaration": {
      "enum": [
        "none",
        "X",
        "Y",
        "Z"
      ]
    },
    "PoseWords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "head",
        "left",
        "right"
      ],
      "description": "PLAN-010 (S-134): the pose in the staff words the prompt prints, the model's intent; the compiler turns them into the joint angles (solver/intent.py) and the solver puts each contact on its target. body: null upright, 'inverted', or '<direction> (<n> lean)'; head: null upright or a direction; each side's arm and leg a direction, its lower arm and leg 'straight' or 'folded <n>'.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(inverted|[a-z-]+-(high|mid|low) \\([0-9]+ lean\\))$"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "forward-high",
                "forward-mid",
                "forward-low",
                "left-forward-high",
                "left-forward-mid",
                "left-forward-low",
                "left-high",
                "left-mid",
                "left-low",
                "left-back-high",
                "left-back-mid",
                "left-back-low",
                "back-high",
                "back-mid",
                "back-low",
                "right-back-high",
                "right-back-mid",
                "right-back-low",
                "right-high",
                "right-mid",
                "right-low",
                "right-forward-high",
                "right-forward-mid",
                "right-forward-low",
                "place-high",
                "place-low"
              ]
            }
          ]
        },
        "left": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm",
            "lower_arm",
            "leg",
            "lower_leg"
          ],
          "properties": {
            "arm": {
              "enum": [
                "forward-high",
                "forward-mid",
                "forward-low",
                "left-forward-high",
                "left-forward-mid",
                "left-forward-low",
                "left-high",
                "left-mid",
                "left-low",
                "left-back-high",
                "left-back-mid",
                "left-back-low",
                "back-high",
                "back-mid",
                "back-low",
                "right-back-high",
                "right-back-mid",
                "right-back-low",
                "right-high",
                "right-mid",
                "right-low",
                "right-forward-high",
                "right-forward-mid",
                "right-forward-low",
                "place-high",
                "place-low"
              ]
            },
            "lower_arm": {
              "type": "string",
              "pattern": "^(straight|folded (1[5-9]|[2-9][0-9]|1[0-7][0-9]|180))$"
            },
            "leg": {
              "enum": [
                "forward-high",
                "forward-mid",
                "forward-low",
                "left-forward-high",
                "left-forward-mid",
                "left-forward-low",
                "left-high",
                "left-mid",
                "left-low",
                "left-back-high",
                "left-back-mid",
                "left-back-low",
                "back-high",
                "back-mid",
                "back-low",
                "right-back-high",
                "right-back-mid",
                "right-back-low",
                "right-high",
                "right-mid",
                "right-low",
                "right-forward-high",
                "right-forward-mid",
                "right-forward-low",
                "place-high",
                "place-low"
              ]
            },
            "lower_leg": {
              "type": "string",
              "pattern": "^(straight|folded (1[5-9]|[2-9][0-9]|1[0-7][0-9]|180))$"
            }
          }
        },
        "right": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm",
            "lower_arm",
            "leg",
            "lower_leg"
          ],
          "properties": {
            "arm": {
              "enum": [
                "forward-high",
                "forward-mid",
                "forward-low",
                "left-forward-high",
                "left-forward-mid",
                "left-forward-low",
                "left-high",
                "left-mid",
                "left-low",
                "left-back-high",
                "left-back-mid",
                "left-back-low",
                "back-high",
                "back-mid",
                "back-low",
                "right-back-high",
                "right-back-mid",
                "right-back-low",
                "right-high",
                "right-mid",
                "right-low",
                "right-forward-high",
                "right-forward-mid",
                "right-forward-low",
                "place-high",
                "place-low"
              ]
            },
            "lower_arm": {
              "type": "string",
              "pattern": "^(straight|folded (1[5-9]|[2-9][0-9]|1[0-7][0-9]|180))$"
            },
            "leg": {
              "enum": [
                "forward-high",
                "forward-mid",
                "forward-low",
                "left-forward-high",
                "left-forward-mid",
                "left-forward-low",
                "left-high",
                "left-mid",
                "left-low",
                "left-back-high",
                "left-back-mid",
                "left-back-low",
                "back-high",
                "back-mid",
                "back-low",
                "right-back-high",
                "right-back-mid",
                "right-back-low",
                "right-high",
                "right-mid",
                "right-low",
                "right-forward-high",
                "right-forward-mid",
                "right-forward-low",
                "place-high",
                "place-low"
              ]
            },
            "lower_leg": {
              "type": "string",
              "pattern": "^(straight|folded (1[5-9]|[2-9][0-9]|1[0-7][0-9]|180))$"
            }
          }
        }
      }
    }
  }
}
