{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:motion_plan:2.0",
  "title": "S13 motion plan (authored in-session): one Euler key pose per entity per beat",
  "description": "Root pos equals the S04 anchor; rot agrees with the S04 facing; bones are the kernel joints; turns declare their axis (flip X, spin Y, cartwheel Z).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "keys"
  ],
  "properties": {
    "step_id": {
      "const": "S13"
    },
    "band": {
      "const": "L4c"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "name",
          "pos",
          "rot",
          "bones",
          "turn",
          "axis_declaration",
          "description"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rot": {
            "$ref": "#/$defs/EulerXYZ"
          },
          "bones": {
            "type": "object",
            "patternProperties": {
              "^[A-Z][A-Za-z]*$": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "description": "Local joint Euler degrees relative to the rest pose, same convention as the root."
              }
            },
            "additionalProperties": false
          },
          "turn": {
            "$ref": "#/$defs/Turn"
          },
          "axis_declaration": {
            "$ref": "#/$defs/AxisDeclaration"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "EulerXYZ": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1080,
        "maximum": 1080
      },
      "description": "Root Euler degrees [X, Y, Z], intrinsic XYZ, right-handed; continuous per entity (never wrapped)."
    },
    "Turn": {
      "enum": [
        "none",
        "flip",
        "spin",
        "cartwheel"
      ]
    },
    "AxisDeclaration": {
      "enum": [
        "none",
        "X",
        "Y",
        "Z"
      ]
    }
  }
}
