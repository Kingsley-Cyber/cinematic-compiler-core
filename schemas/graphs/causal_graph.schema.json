{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:causal_graph:1.1",
  "title": "S05 causal graph: cause edges between beats",
  "description": "Edges come from the beat plan's causes. The schema allows branching; scene.quadrant.linear: true makes S05 reject a beat with more than one outgoing cause. Quadrant scores are in scene.quadrant (envelope schema).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "causal"
  ],
  "properties": {
    "causal": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "causal_strength",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$"
          },
          "to": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$"
          },
          "causal_strength": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
