{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:facial_plan:1.0",
  "title": "S14 facial plan (authored in-session): one face per entity per beat",
  "description": "FACS action units (even or per side), units that must not show, valence and arousal on -1..1, emotion label, display rule, gaze target (an entity or prop id, camera, none), salience for the camera, and how the expression arrives (onset, frames).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "faces"
  ],
  "properties": {
    "step_id": {
      "const": "S14"
    },
    "band": {
      "const": "L4d"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "aus",
          "inactive_aus",
          "valence",
          "arousal",
          "emotion_label",
          "display_rule",
          "gaze_target",
          "salience",
          "onset",
          "onset_frames",
          "description"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "aus": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "au",
                    "intensity",
                    "bilateral"
                  ],
                  "properties": {
                    "au": {
                      "type": "string",
                      "pattern": "^AU[0-9]{1,2}$"
                    },
                    "intensity": {
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    },
                    "bilateral": {
                      "const": true
                    }
                  },
                  "description": "Even on both sides (FACS bilateral)."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "au",
                    "left_intensity",
                    "right_intensity",
                    "bilateral",
                    "asymmetry"
                  ],
                  "properties": {
                    "au": {
                      "type": "string",
                      "pattern": "^AU[0-9]{1,2}$"
                    },
                    "left_intensity": {
                      "anyOf": [
                        {
                          "enum": [
                            "A",
                            "B",
                            "C",
                            "D",
                            "E"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "right_intensity": {
                      "anyOf": [
                        {
                          "enum": [
                            "A",
                            "B",
                            "C",
                            "D",
                            "E"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bilateral": {
                      "const": false
                    },
                    "asymmetry": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "dominant_side",
                        "magnitude",
                        "pattern"
                      ],
                      "properties": {
                        "dominant_side": {
                          "enum": [
                            "left",
                            "right"
                          ]
                        },
                        "magnitude": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 5
                        },
                        "pattern": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]*$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "description": "Sides differ: both present at different intensities (FACS A) or one side only (FACS R/L, the other null). Left and right are the performer's own sides; magnitude counts intensity steps between the sides (absent = 0, A = 1 ... E = 5)."
                }
              ]
            }
          },
          "inactive_aus": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AU[0-9]{1,2}$"
            }
          },
          "valence": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "arousal": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "emotion_label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_rule": {
            "enum": [
              "genuine",
              "masked",
              "suppressed",
              "posed"
            ]
          },
          "gaze_target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "salience": {
            "enum": [
              "carries_beat",
              "supporting",
              "background"
            ]
          },
          "onset": {
            "enum": [
              "rapid",
              "slow",
              "hold",
              "micro"
            ]
          },
          "onset_frames": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
