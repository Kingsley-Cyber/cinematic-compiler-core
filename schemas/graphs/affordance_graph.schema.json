{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:affordance_graph:1.1",
  "title": "S10 affordance graph",
  "description": "affordance = one proven functional verb per S08 interaction (before/after object states, grip, duration); affordance_dependency = an earlier verb's postconditions enabling a later verb's preconditions on the same object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "affordance",
    "affordance_dependency"
  ],
  "properties": {
    "affordance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "action",
          "preconditions",
          "postconditions",
          "required_grip",
          "agent_grip",
          "duration",
          "duration_range",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^i[0-9]{2,3}$"
          },
          "object": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "values"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "values"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "required_grip": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "agent_grip": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "before": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "after": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "affordance_dependency": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "via"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^i[0-9]{2,3}$"
          },
          "to": {
            "type": "string",
            "pattern": "^i[0-9]{2,3}$"
          },
          "via": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    }
  }
}
