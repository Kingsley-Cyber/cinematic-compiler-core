{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:pose_mechanics_graph:1.3",
  "title": "S14 pose mechanics graph (PLAN-009): what makes each pose read, computed from the motion keys",
  "description": "One node per S13 key (its id), one edge between a performer's consecutive poses. S-125 adds the empty step; each mechanic (line of action, counterbalance, weight distribution) adds its own fields in its own slice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pose_mechanics",
    "pose_mechanics_transition"
  ],
  "properties": {
    "pose_mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "line_of_action",
          "centre_of_mass",
          "counterbalance",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "line_of_action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shape",
              "apex",
              "tension",
              "bulge",
              "chord",
              "base",
              "inverted"
            ],
            "description": "PM-3 (S-126): the curve from the head through the chest and pelvis to the base foot (solver/pose_mechanics.py).",
            "properties": {
              "shape": {
                "enum": [
                  "straight",
                  "c",
                  "s"
                ]
              },
              "apex": {
                "enum": [
                  "torso",
                  "pelvis"
                ]
              },
              "tension": {
                "type": "number",
                "minimum": 0
              },
              "bulge": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "chord": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "base": {
                "enum": [
                  "left_foot",
                  "right_foot"
                ]
              },
              "inverted": {
                "type": "boolean"
              }
            }
          },
          "centre_of_mass": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            },
            "description": "S-127: the body's centre of mass (Dempster via Winter, library/body_segments.yaml masses)."
          },
          "counterbalance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "extended",
              "lead",
              "reach_m",
              "counter"
            ],
            "description": "S-127: the nearly straight limbs reaching out from the centre of mass, the one reaching furthest, and the limbs on the other side that counter it (solver/pose_mechanics.py).",
            "properties": {
              "extended": {
                "type": "array",
                "items": {
                  "enum": [
                    "left_arm",
                    "right_arm",
                    "left_leg",
                    "right_leg"
                  ]
                }
              },
              "lead": {
                "anyOf": [
                  {
                    "enum": [
                      "left_arm",
                      "right_arm",
                      "left_leg",
                      "right_leg"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reach_m": {
                "type": "number",
                "minimum": 0
              },
              "counter": {
                "type": "array",
                "items": {
                  "enum": [
                    "left_arm",
                    "right_arm",
                    "left_leg",
                    "right_leg"
                  ]
                }
              }
            }
          },
          "weight": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "supports",
                  "share",
                  "margin_m"
                ],
                "description": "S-128: the parts S11 says carry the body, each one's share of the weight, and how far inside its support base (spread a half foot) the centre of mass stands (negative: outside). Null for a body nothing carries.",
                "properties": {
                  "supports": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "share": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "margin_m": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "pose_mechanics_transition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
