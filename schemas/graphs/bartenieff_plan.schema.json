{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:bartenieff_plan:1.0",
  "title": "S12 Bartenieff plan (authored in-session): body coordination per entity per beat",
  "description": "One node per packet slot. Values from library/bartenieff_vocabulary.yaml and library/body_modes; cpcs: values are labelled extensions, not native LMA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "nodes"
  ],
  "properties": {
    "step_id": {
      "const": "S12"
    },
    "band": {
      "const": "L4b"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "connectivity",
          "developmental_pattern",
          "intent",
          "initiation",
          "follow_through",
          "body_mode"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "connectivity": {
            "type": "string",
            "minLength": 1
          },
          "developmental_pattern": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "initiation": {
            "type": "string",
            "minLength": 1
          },
          "follow_through": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "body_mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
