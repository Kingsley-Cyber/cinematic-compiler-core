{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:motion_graph:1.4",
  "title": "S13 motion graph",
  "description": "motion = key poses (/nodes/motion) with derived quaternions; motion_edges = follows edges (/edges/motion) with derived Euler deltas, interpolation and root trajectory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "motion",
    "motion_edges"
  ],
  "properties": {
    "motion": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entity",
          "beat",
          "t",
          "name",
          "pos",
          "rot",
          "quat",
          "bones",
          "turn",
          "axis_declaration",
          "heading_basis",
          "description",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "beat": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rot": {
            "$ref": "#/$defs/EulerXYZ"
          },
          "quat": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "description": "Derived [w, x, y, z] of the root rot, w >= 0."
          },
          "bones": {
            "description": "Joint angles, one entry per kernel joint. Canonical order: the kernel skeleton key (kernel/invariants.yaml 'key' rows: Sp, LUL, RUL, LL, RL, LA, RA, LFA, RFA, HD, NK); S13 writes it, the stored envelope sorts keys, so every reader takes the order from the kernel, never from this object (JOINTS_IN_CANONICAL_ORDER, DETERMINISM).",
            "type": "object",
            "patternProperties": {
              "^[A-Z][A-Za-z]*$": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "description": "Local joint Euler degrees relative to the rest pose, same convention as the root."
              }
            },
            "additionalProperties": false
          },
          "turn": {
            "$ref": "#/$defs/Turn"
          },
          "axis_declaration": {
            "$ref": "#/$defs/AxisDeclaration"
          },
          "heading_basis": {
            "enum": [
              "forward",
              "lateral"
            ],
            "description": "Axis that read the root heading for the S04 facing check."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "object",
            "description": "Owner O24, O72 (M9-06a): world points of the key by forward kinematics from the pelvis root (solver/forward_kinematics.py, library/body_segments.yaml).",
            "additionalProperties": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "motion_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "relation",
          "turn",
          "axis_declaration",
          "euler_delta",
          "interpolation",
          "slerp_angle",
          "trajectory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "relation": {
            "const": "follows"
          },
          "turn": {
            "$ref": "#/$defs/Turn"
          },
          "axis_declaration": {
            "$ref": "#/$defs/AxisDeclaration"
          },
          "euler_delta": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -2160,
              "maximum": 2160
            },
            "description": "to.rot - from.rot: the rotation performed."
          },
          "interpolation": {
            "enum": [
              "slerp",
              "euler_axis"
            ],
            "description": "slerp for undeclared changes (< 90 degrees) and for a declared turn under a half turn about its axis (the shortest arc is that turn); euler_axis for a declared turn of a half turn or more, which a shortest-arc slerp would undo (RV-108)."
          },
          "slerp_angle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "trajectory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "displacement",
              "distance",
              "duration",
              "speed"
            ],
            "properties": {
              "displacement": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "speed": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "inbetweens": {
            "type": "array",
            "description": "ADR-O109 (RV-59f): the in-between keys of the span this edge follows, in time order; the declared interpolation runs through them.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "entity",
                "t",
                "name",
                "pos",
                "rot",
                "quat",
                "bones",
                "turn",
                "description",
                "points"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*@[0-9]+(\\.[0-9]+)?$"
                },
                "entity": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "pos": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "rot": {
                  "$ref": "#/$defs/EulerXYZ"
                },
                "quat": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "description": "Derived [w, x, y, z] of the root rot, w >= 0."
                },
                "bones": {
                  "description": "Joint angles, one entry per kernel joint. Canonical order: the kernel skeleton key (kernel/invariants.yaml 'key' rows: Sp, LUL, RUL, LL, RL, LA, RA, LFA, RFA, HD, NK); S13 writes it, the stored envelope sorts keys, so every reader takes the order from the kernel, never from this object (JOINTS_IN_CANONICAL_ORDER, DETERMINISM).",
                  "type": "object",
                  "patternProperties": {
                    "^[A-Z][A-Za-z]*$": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "description": "Local joint Euler degrees relative to the rest pose, same convention as the root."
                    }
                  },
                  "additionalProperties": false
                },
                "turn": {
                  "$ref": "#/$defs/Turn"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "points": {
                  "type": "object",
                  "description": "Owner O24, O72 (M9-06a): world points of the key by forward kinematics from the pelvis root (solver/forward_kinematics.py, library/body_segments.yaml).",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "EulerXYZ": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1080,
        "maximum": 1080
      },
      "description": "Root Euler degrees [X, Y, Z], intrinsic XYZ, right-handed; continuous per entity (never wrapped)."
    },
    "Turn": {
      "enum": [
        "none",
        "flip",
        "spin",
        "cartwheel"
      ]
    },
    "AxisDeclaration": {
      "enum": [
        "none",
        "X",
        "Y",
        "Z"
      ]
    }
  }
}
