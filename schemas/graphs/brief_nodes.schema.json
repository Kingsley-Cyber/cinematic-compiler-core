{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:brief_nodes:1.2",
  "title": "S02 brief node items (band L0.5): entities, props, surfaces",
  "description": "Item schemas for the groups S02 writes. Every field is copied from a library card; hints carry their S01 query evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entities",
    "props",
    "surfaces"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prop"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Surface"
      }
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "span",
        "text"
      ],
      "properties": {
        "source": {
          "const": "query"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "card_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "card_version": {
          "type": "integer",
          "minimum": 1
        },
        "card_status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "hint_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "silhouette": {
          "type": "string",
          "minLength": 1
        },
        "costume": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "face_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visible_regions",
            "dominant_side",
            "emotional_range",
            "resting"
          ],
          "properties": {
            "visible_regions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "brows",
                  "eyes",
                  "cheeks",
                  "nose",
                  "mouth",
                  "jaw"
                ]
              }
            },
            "dominant_side": {
              "enum": [
                "left",
                "right",
                "none"
              ]
            },
            "emotional_range": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "neutral",
                  "joy",
                  "interest",
                  "surprise",
                  "anger",
                  "fear",
                  "sadness",
                  "disgust",
                  "contempt"
                ]
              }
            },
            "resting": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "valence",
                "arousal"
              ],
              "properties": {
                "valence": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "arousal": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            }
          },
          "description": "S14 facial: which face regions the costume leaves visible, the side that leads asymmetric expressions, the emotion families the archetype shows and its resting valence/arousal (-1..1)."
        }
      },
      "required": [
        "id",
        "card_id",
        "card_version",
        "card_status",
        "hint",
        "hint_evidence",
        "name",
        "description",
        "silhouette",
        "costume",
        "parts",
        "capabilities",
        "modes"
      ]
    },
    "Prop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "card_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "card_version": {
          "type": "integer",
          "minimum": 1
        },
        "card_status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "hint_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "$ref": "#/$defs/CardEvidence"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "affordances": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "grips": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "property",
              "values"
            ],
            "properties": {
              "property": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 2
        },
        "unit_name": {
          "type": "string",
          "minLength": 1
        },
        "group_name": {
          "type": "string",
          "minLength": 1
        },
        "carried_by": {
          "description": "The entity whose archetype card lists this prop as equipment (owner O63), or null.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "card_id",
        "card_version",
        "card_status",
        "hint",
        "hint_evidence",
        "name",
        "description",
        "parts",
        "materials",
        "affordances",
        "grips",
        "states",
        "carried_by"
      ]
    },
    "Surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "world_card_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "card_version": {
          "type": "integer",
          "minimum": 1
        },
        "card_status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "kind": {
          "enum": [
            "floor",
            "wall",
            "boundary",
            "obstacle",
            "tabletop",
            "backdrop"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "boxes": {
          "type": "array",
          "minItems": 1,
          "description": "Where the surface is (R20 next action 2): one or more axis-aligned boxes in scene metres, {min: [x, y, z], max: [x, y, z]}; a floor's top is its highest max y. Several boxes for a surface in pieces (a boundary on four sides).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "max": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "ax": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "world_card_id",
        "card_version",
        "card_status",
        "kind",
        "description",
        "boxes"
      ]
    },
    "CardEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "card_id",
        "field"
      ],
      "properties": {
        "source": {
          "const": "card"
        },
        "card_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "field": {
          "const": "equipment"
        }
      }
    }
  }
}
