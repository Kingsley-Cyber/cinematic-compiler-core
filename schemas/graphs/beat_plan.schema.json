{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:beat_plan:1.0",
  "title": "S04 beat plan (authored in-session from a hash-bound packet)",
  "description": "LLM call #1 of the owner plan, written by Claude in-session (no paid API). Times in seconds; requires are read at t, effects and contacts commit at t + dur. pos/facing are the root anchors at the beat start t (the key-pose time) and are authoritative for S06 and S13.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "beats"
  ],
  "properties": {
    "step_id": {
      "const": "S04"
    },
    "band": {
      "const": "L1"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Beat"
      }
    }
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "prop",
            "surface"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "Vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "property",
        "value"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/Ref"
        },
        "property": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_type",
        "a",
        "b"
      ],
      "properties": {
        "contact_type": {
          "enum": [
            "touch",
            "possess",
            "support",
            "release"
          ]
        },
        "a": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "part"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "part": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "part"
          ],
          "properties": {
            "kind": {
              "enum": [
                "entity",
                "prop",
                "surface"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "part": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "Cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "causal_strength",
        "why"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^b[0-9]{2,3}$"
        },
        "causal_strength": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "t",
        "dur",
        "event_type",
        "actor",
        "label",
        "participants",
        "modes",
        "pos",
        "facing",
        "action",
        "requires",
        "effects",
        "contacts",
        "causes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]{2,3}$"
        },
        "t": {
          "type": "number",
          "minimum": 0
        },
        "dur": {
          "type": "number",
          "minimum": 0
        },
        "event_type": {
          "enum": [
            "action",
            "hold",
            "transition"
          ]
        },
        "actor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "pos": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Vec3"
          }
        },
        "facing": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Vec3"
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contact"
          }
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cause"
          }
        }
      }
    }
  }
}
