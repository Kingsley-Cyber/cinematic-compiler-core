{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:render:1.1",
  "title": "S17 render (projection group, no edges)",
  "description": "The projected prompt: target layout, variant, the full uncompressed text and its sha256, item-level coverage (complete by owner invariant no_render_compression), actor labels and the frame-part directives. M8 (owner O1-O3): the same item carries the structured-prose prompts, the knowledge DAG's Master Template compiled in four movement modes alongside LBN-2.4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "render"
  ],
  "properties": {
    "render": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "variant",
          "labels",
          "text",
          "sha256",
          "coverage",
          "frame_parts",
          "prose"
        ],
        "properties": {
          "id": {
            "const": "render"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "type": "string",
                "pattern": "^[A-Z]$"
              }
            },
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groups",
              "constraints",
              "complete"
            ],
            "properties": {
              "groups": {
                "type": "object",
                "patternProperties": {
                  "^[a-z][a-z0-9_]*$": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "items",
                      "rendered",
                      "missing"
                    ],
                    "properties": {
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "rendered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "missing": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false
              },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "applied",
                  "rendered",
                  "enforced_by_renderer",
                  "missing"
                ],
                "properties": {
                  "applied": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rendered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "enforced_by_renderer": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "missing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "complete": {
                "const": true
              }
            }
          },
          "frame_parts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "impact",
              "smear",
              "speedlines",
              "holds",
              "fx",
              "ink"
            ],
            "properties": {
              "impact": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "smear": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "t0",
                    "t1",
                    "subject",
                    "part",
                    "note"
                  ],
                  "properties": {
                    "t0": {
                      "type": "number",
                      "minimum": 0
                    },
                    "t1": {
                      "type": "number",
                      "minimum": 0
                    },
                    "subject": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "part": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "speedlines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "t0",
                    "t1",
                    "subject"
                  ],
                  "properties": {
                    "t0": {
                      "type": "number",
                      "minimum": 0
                    },
                    "t1": {
                      "type": "number",
                      "minimum": 0
                    },
                    "subject": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                }
              },
              "holds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "t",
                    "frames"
                  ],
                  "properties": {
                    "t": {
                      "type": "number",
                      "minimum": 0
                    },
                    "frames": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "fx": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "t",
                    "t_end",
                    "text"
                  ],
                  "properties": {
                    "t": {
                      "type": "number",
                      "minimum": 0
                    },
                    "t_end": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "ink": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "prose": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pure_staff",
              "mixed",
              "upgraded_mixed",
              "euler_heavy"
            ],
            "properties": {
              "pure_staff": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "variant",
                  "text",
                  "sha256",
                  "omitted_constraints"
                ],
                "properties": {
                  "target": {
                    "const": "structured-prose"
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^DAG-PROSE-[A-Z-]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "omitted_constraints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Applied constraints the prose leaves out on purpose (owner O3: the kernel rule '<label> root exact')."
                  }
                }
              },
              "mixed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "variant",
                  "text",
                  "sha256",
                  "omitted_constraints"
                ],
                "properties": {
                  "target": {
                    "const": "structured-prose"
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^DAG-PROSE-[A-Z-]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "omitted_constraints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Applied constraints the prose leaves out on purpose (owner O3: the kernel rule '<label> root exact')."
                  }
                }
              },
              "upgraded_mixed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "variant",
                  "text",
                  "sha256",
                  "omitted_constraints"
                ],
                "properties": {
                  "target": {
                    "const": "structured-prose"
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^DAG-PROSE-[A-Z-]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "omitted_constraints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Applied constraints the prose leaves out on purpose (owner O3: the kernel rule '<label> root exact')."
                  }
                }
              },
              "euler_heavy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "variant",
                  "text",
                  "sha256",
                  "omitted_constraints"
                ],
                "properties": {
                  "target": {
                    "const": "structured-prose"
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^DAG-PROSE-[A-Z-]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "omitted_constraints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Applied constraints the prose leaves out on purpose (owner O3: the kernel rule '<label> root exact')."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
