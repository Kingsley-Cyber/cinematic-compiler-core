{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:effort_plan:1.1",
  "title": "S16 effort plan (authored in-session): LMA Effort, Shape and Space per interval",
  "description": "Intervals of consecutive slots of one entity; every slot is covered once. Values from library/laban_vocabulary.yaml; effort_mode is a library/effort_modes card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "intervals"
  ],
  "properties": {
    "step_id": {
      "const": "S16"
    },
    "band": {
      "const": "L5"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor",
          "beats",
          "effort",
          "effort_action",
          "shape",
          "space",
          "intensity",
          "effort_mode"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^b[0-9]{2,3}$"
            }
          },
          "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weight",
              "time",
              "space",
              "flow"
            ],
            "properties": {
              "weight": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "minLength": 1
              },
              "space": {
                "type": "string",
                "minLength": 1
              },
              "flow": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "effort_action": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quality",
              "mode"
            ],
            "properties": {
              "quality": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "space": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kinesphere",
              "pathway",
              "plane"
            ],
            "properties": {
              "kinesphere": {
                "type": "string",
                "minLength": 1
              },
              "pathway": {
                "type": "string",
                "minLength": 1
              },
              "plane": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "effort_mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
