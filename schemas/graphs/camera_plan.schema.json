{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:camera_plan:1.0",
  "title": "S15 camera plan (authored in-session): the shot list",
  "description": "Shots tile the scene in time order; each shot follows schemas/camera.schema.json (embedded as $defs.shot).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "shots"
  ],
  "properties": {
    "step_id": {
      "const": "S15"
    },
    "band": {
      "const": "L5.5"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    }
  },
  "$defs": {
    "shot": {
      "title": "Camera shot node (S15, L5.5)",
      "description": "One shot: its time window, the beats it shows, the 13 subdivisions and its motivation, all required. Closed values come from library/camera_subdivisions.yaml.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "t",
        "dur",
        "beats",
        "intent",
        "motivation",
        "framing",
        "angle",
        "position",
        "lens",
        "focus",
        "movement",
        "movement_quality",
        "support",
        "relation_to_action",
        "composition",
        "playback",
        "blur",
        "editing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[0-9]{2,3}$"
        },
        "t": {
          "type": "number",
          "minimum": 0
        },
        "dur": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$"
          }
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "motivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_@-]*$"
            }
          }
        },
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "subjects",
            "detail",
            "visible_action"
          ],
          "properties": {
            "scale": {
              "type": "string",
              "minLength": 1
            },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "detail": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "visible_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "angle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elevation_deg",
            "azimuth_deg",
            "roll_deg"
          ],
          "properties": {
            "elevation_deg": {
              "type": "number",
              "minimum": -89,
              "maximum": 89
            },
            "azimuth_deg": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "roll_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          "description": "elevation: camera above (+) or below (-) the aim point; azimuth: world heading from the aim point to the camera, degrees from +Z toward +X; roll: dutch tilt."
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "distance_m",
            "side"
          ],
          "properties": {
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "distance_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "side": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "target: an entity id or midpoint (between the axis entities); the camera sits distance_m from the aim point (target + aim height)."
        },
        "lens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focal_length_mm",
            "perspective"
          ],
          "properties": {
            "focal_length_mm": {
              "type": "number",
              "minimum": 4,
              "maximum": 1200
            },
            "perspective": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "depth_of_field",
            "transition"
          ],
          "properties": {
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "depth_of_field": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "movement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "movement_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "easing",
            "stability",
            "texture"
          ],
          "properties": {
            "easing": {
              "type": "string",
              "minLength": 1
            },
            "stability": {
              "type": "string",
              "minLength": 1
            },
            "texture": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rig"
          ],
          "properties": {
            "rig": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "relation_to_action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "subject",
            "note"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement",
            "depth_anchor",
            "negative_space"
          ],
          "properties": {
            "placement": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "depth_anchor": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "negative_space": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "treatment",
            "speed"
          ],
          "properties": {
            "treatment": {
              "type": "string",
              "minLength": 1
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "blur": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motion_blur",
            "affected"
          ],
          "properties": {
            "motion_blur": {
              "type": "string",
              "minLength": 1
            },
            "affected": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        "editing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition_in",
            "axis",
            "eyeline"
          ],
          "properties": {
            "transition_in": {
              "type": "string",
              "minLength": 1
            },
            "axis": {
              "type": "string",
              "minLength": 1
            },
            "eyeline": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
