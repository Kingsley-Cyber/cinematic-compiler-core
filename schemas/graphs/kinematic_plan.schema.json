{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:kinematic_plan:1.1",
  "title": "S11 kinematic plan (authored in-session): visible bodily organization per entity per beat",
  "description": "One node per packet slot. support lists the entity's own parts bearing weight at the beat start; the ten cues come from library/kinematic_cues.yaml; reads says what the audience sees.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "band",
    "packet_sha256",
    "author",
    "attempt",
    "nodes"
  ],
  "properties": {
    "step_id": {
      "const": "S11"
    },
    "band": {
      "const": "L4a"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "support",
          "balance",
          "loading",
          "bracing",
          "yielding",
          "weight_transfer",
          "tension",
          "release",
          "strain",
          "restraint",
          "breathing",
          "reads"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "support": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "balance": {
            "type": "string",
            "minLength": 1
          },
          "loading": {
            "type": "string",
            "minLength": 1
          },
          "bracing": {
            "type": "string",
            "minLength": 1
          },
          "yielding": {
            "type": "string",
            "minLength": 1
          },
          "weight_transfer": {
            "type": "string",
            "minLength": 1
          },
          "tension": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "strain": {
            "type": "string",
            "minLength": 1
          },
          "restraint": {
            "type": "string",
            "minLength": 1
          },
          "breathing": {
            "type": "string",
            "minLength": 1
          },
          "reads": {
            "type": "string",
            "minLength": 1
          },
          "float": {
            "type": "boolean",
            "description": "Owner O74: anime only, on an airborne key; the key's span hangs (stylised hang time) instead of following the gravity arc (MOMENTUM_MISSING)."
          }
        }
      }
    }
  }
}
