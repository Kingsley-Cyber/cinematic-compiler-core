{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:state_graph:1.6",
  "title": "S06 state graph: one state per subject per beat (+ end), transitions with triggering beats",
  "description": "States are replayed from the beat plan: requires are read at t, effects commit at t + dur (at t when marked `at: start`, O91; a change of hands at its possess or release, F-061); a property's starting value comes only from its first requirement, else unknown. pos/facing come from the beat (authoritative) or are carried from the entity's last anchor. A beat's snapshot holds the values after its own at-start effects; before_own_effects keeps, where they changed a value, the value before them, as the beat's requirements read it (F-161, RV-61).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "states",
    "state_transition"
  ],
  "properties": {
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "beat",
          "t",
          "pos",
          "facing",
          "conditions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "entity",
                  "prop",
                  "surface"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          },
          "beat": {
            "type": "string",
            "pattern": "^(b[0-9]{2,3}|end)$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "pos": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "facing": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "hands": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left_hand",
              "right_hand"
            ],
            "description": "A performer's hands at this state (R20 next action 1): each hand empty or holding a named prop, from the props' holder at the same state and the last possess contact that names the hand; `unplaced` lists a prop it holds by no contact naming a hand. Absent for a performer without hands and for props and surfaces.",
            "properties": {
              "left_hand": {
                "type": "string",
                "minLength": 1
              },
              "right_hand": {
                "type": "string",
                "minLength": 1
              },
              "unplaced": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "before_own_effects": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "F-161 (RV-61): the values at the beat's start before its own effects, for the properties those effects changed there; absent when they changed none."
          }
        }
      }
    },
    "state_transition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_state",
          "to_state",
          "trigger_event",
          "t",
          "changes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from_state": {
            "type": "string"
          },
          "to_state": {
            "type": "string"
          },
          "trigger_event": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^b[0-9]{2,3}$"
            }
          },
          "t": {
            "type": "number",
            "minimum": 0,
            "description": "The instant the last of the changes takes effect; each change carries its own (F-132)."
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "from",
                "to",
                "t"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "description": "The instant this change takes effect: its beat's end, its start for an effect marked `at: start` (O91), or for a change of hands the instant of the possess or release that makes it (F-061); the last such commit when several land between two states (F-132)."
                }
              }
            }
          }
        }
      }
    }
  }
}
