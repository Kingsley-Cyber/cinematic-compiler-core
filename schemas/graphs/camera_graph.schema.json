{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:camera_graph:2.2",
  "title": "S17 camera graph",
  "description": "camera = shots with derived geometry (/nodes/camera); camera_edges = shot-to-shot cuts with axis and angle change (/edges/camera).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "camera_edges"
  ],
  "properties": {
    "camera": {
      "type": "array",
      "items": {
        "description": "Authored shot fields plus derived geometry.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "t",
          "dur",
          "beats",
          "intent",
          "motivation",
          "framing",
          "angle",
          "position",
          "lens",
          "focus",
          "movement",
          "movement_quality",
          "support",
          "relation_to_action",
          "composition",
          "playback",
          "blur",
          "editing",
          "derived"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]{2,3}$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "dur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^b[0-9]{2,3}$"
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "motivation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_@-]*$"
              }
            }
          },
          "framing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scale",
              "subjects",
              "detail",
              "visible_action"
            ],
            "properties": {
              "scale": {
                "type": "string",
                "minLength": 1
              },
              "subjects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "visible_action": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "angle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "elevation_deg",
              "azimuth_deg",
              "roll_deg"
            ],
            "properties": {
              "elevation_deg": {
                "type": "number",
                "minimum": -89,
                "maximum": 89
              },
              "azimuth_deg": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "roll_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "description": "elevation: camera above (+) or below (-) the aim point; azimuth: world heading from the aim point to the camera, degrees from +Z toward +X; roll: dutch tilt."
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "distance_m",
              "side"
            ],
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "distance_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "side": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "target: an entity id or midpoint (between the axis entities); the camera sits distance_m from the aim point: the middle of the parts its scale shows of the target (both axis entities for midpoint), or an insert's detail (a part of the target or a prop)."
          },
          "lens": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "focal_length_mm",
              "perspective"
            ],
            "properties": {
              "focal_length_mm": {
                "type": "number",
                "minimum": 4,
                "maximum": 1200
              },
              "perspective": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "focus": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "depth_of_field",
              "transition"
            ],
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "depth_of_field": {
                "type": "string",
                "minLength": 1
              },
              "transition": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "movement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "movement_quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "easing",
              "stability",
              "texture"
            ],
            "properties": {
              "easing": {
                "type": "string",
                "minLength": 1
              },
              "stability": {
                "type": "string",
                "minLength": 1
              },
              "texture": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rig"
            ],
            "properties": {
              "rig": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "relation_to_action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "subject",
              "note"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "composition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "placement",
              "depth_anchor",
              "negative_space"
            ],
            "properties": {
              "placement": {
                "type": "object",
                "patternProperties": {
                  "^[a-z][a-z0-9_]*$": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "depth_anchor": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "negative_space": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "playback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "treatment",
              "speed"
            ],
            "properties": {
              "treatment": {
                "type": "string",
                "minLength": 1
              },
              "speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          },
          "blur": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "motion_blur",
              "affected"
            ],
            "properties": {
              "motion_blur": {
                "type": "string",
                "minLength": 1
              },
              "affected": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          },
          "editing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transition_in",
              "axis",
              "eyeline"
            ],
            "properties": {
              "transition_in": {
                "type": "string",
                "minLength": 1
              },
              "axis": {
                "type": "string",
                "minLength": 1
              },
              "eyeline": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "derived": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "camera_pos",
              "aim",
              "height_m",
              "side",
              "fov_deg",
              "frame_height_m",
              "screen_x",
              "silhouette"
            ],
            "properties": {
              "camera_pos": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "aim": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "height_m": {
                "type": "number"
              },
              "side": {
                "enum": [
                  "left",
                  "right",
                  "on_axis",
                  "none"
                ]
              },
              "fov_deg": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "frame_height_m": {
                "type": "number"
              },
              "screen_x": {
                "type": "object",
                "patternProperties": {
                  "^[a-z][a-z0-9_]*$": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "silhouette": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clear",
                  "against"
                ],
                "description": "PLAN-009 PM-4 (S-129): from this shot's camera at its first beat, the framed bodies' hands and feet that read clear in silhouette, and those that fall against a trunk on screen (solver/pose_mechanics.py).",
                "properties": {
                  "clear": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "against": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "subject",
                        "end",
                        "body"
                      ],
                      "properties": {
                        "subject": {
                          "type": "string",
                          "minLength": 1
                        },
                        "end": {
                          "type": "string",
                          "minLength": 1
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "Geometry derived from angle, position and lens (solver/camera_geometry.py)."
          }
        }
      }
    },
    "camera_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "relation",
          "transition",
          "axis",
          "side_from",
          "side_to",
          "azimuth_change_deg",
          "scale_from",
          "scale_to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^c[0-9]{2,3}$"
          },
          "to": {
            "type": "string",
            "pattern": "^c[0-9]{2,3}$"
          },
          "relation": {
            "const": "cuts_to"
          },
          "transition": {
            "type": "string",
            "minLength": 1
          },
          "axis": {
            "type": "string",
            "minLength": 1
          },
          "side_from": {
            "enum": [
              "left",
              "right",
              "on_axis",
              "none"
            ]
          },
          "side_to": {
            "enum": [
              "left",
              "right",
              "on_axis",
              "none"
            ]
          },
          "azimuth_change_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "scale_from": {
            "type": "string",
            "minLength": 1
          },
          "scale_to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
