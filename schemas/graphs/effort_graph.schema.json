{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:effort_graph:1.1",
  "title": "S16 effort graph",
  "description": "efforts = intervals with their time span (/nodes/efforts); effort = overlaps between intervals of different entities, with the shared window (/edges/effort).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "efforts",
    "effort"
  ],
  "properties": {
    "efforts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actor",
          "beats",
          "effort",
          "effort_action",
          "shape",
          "space",
          "intensity",
          "effort_mode",
          "t",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}(-b[0-9]{2,3})?$"
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^b[0-9]{2,3}$"
            }
          },
          "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weight",
              "time",
              "space",
              "flow"
            ],
            "properties": {
              "weight": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "minLength": 1
              },
              "space": {
                "type": "string",
                "minLength": 1
              },
              "flow": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "effort_action": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quality",
              "mode"
            ],
            "properties": {
              "quality": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "space": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kinesphere",
              "pathway",
              "plane"
            ],
            "properties": {
              "kinesphere": {
                "type": "string",
                "minLength": 1
              },
              "pathway": {
                "type": "string",
                "minLength": 1
              },
              "plane": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "effort_mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "effort": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "relation",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}(-b[0-9]{2,3})?$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}(-b[0-9]{2,3})?$"
          },
          "relation": {
            "const": "overlaps"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
