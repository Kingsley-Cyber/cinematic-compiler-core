{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:kinematic_graph:1.0",
  "title": "S11 kinematic graph",
  "description": "Nodes copied from the kinematic plan; transitions computed between an entity's consecutive nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kinematic",
    "kinematic_transition"
  ],
  "properties": {
    "kinematic": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entity",
          "beat",
          "t",
          "support",
          "balance",
          "loading",
          "bracing",
          "yielding",
          "weight_transfer",
          "tension",
          "release",
          "strain",
          "restraint",
          "breathing",
          "reads"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "beat": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "support": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "balance": {
            "type": "string",
            "minLength": 1
          },
          "loading": {
            "type": "string",
            "minLength": 1
          },
          "bracing": {
            "type": "string",
            "minLength": 1
          },
          "yielding": {
            "type": "string",
            "minLength": 1
          },
          "weight_transfer": {
            "type": "string",
            "minLength": 1
          },
          "tension": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "strain": {
            "type": "string",
            "minLength": 1
          },
          "restraint": {
            "type": "string",
            "minLength": 1
          },
          "breathing": {
            "type": "string",
            "minLength": 1
          },
          "reads": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "kinematic_transition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "changes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@b[0-9]{2,3}$"
          },
          "changes": {
            "type": "array",
            "items": {
              "enum": [
                "support",
                "balance",
                "loading",
                "bracing",
                "yielding",
                "weight_transfer",
                "tension",
                "release",
                "strain",
                "restraint",
                "breathing"
              ]
            }
          }
        }
      }
    }
  }
}
