{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:object_state_graph:1.3",
  "title": "S09 object-state graph",
  "description": "object_state = each object's internal card states per beat (+ end) with the S08 interaction in progress; object_state_transition = each internal change with its triggering beat, hand contact (or held:<entity>.<hand>) and interaction. A state keeps S06's before_own_effects for its internal properties, and each change its instant t (F-161, RV-61).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_state",
    "object_state_transition"
  ],
  "properties": {
    "object_state": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "beat",
          "t",
          "state",
          "state_name",
          "interaction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@(b[0-9]{2,3}|end)$"
          },
          "object": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "beat": {
            "type": "string",
            "pattern": "^(b[0-9]{2,3}|end)$"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "state": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "before_own_effects": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "description": "F-161 (RV-61): the internal values at the beat's start before its own effects, where they changed them."
          },
          "state_name": {
            "type": "string",
            "minLength": 1
          },
          "interaction": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^i[0-9]{2,3}$"
          }
        }
      }
    },
    "object_state_transition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "changes",
          "trigger_beat",
          "trigger_contact",
          "interaction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@(b[0-9]{2,3}|end)$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*@(b[0-9]{2,3}|end)$"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "from",
                "to",
                "t"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "description": "The instant the change took effect (S06's change t; F-161)."
                }
              }
            }
          },
          "trigger_beat": {
            "type": "string",
            "pattern": "^b[0-9]{2,3}$"
          },
          "trigger_contact": {
            "type": "string",
            "minLength": 1
          },
          "interaction": {
            "type": "string",
            "pattern": "^i[0-9]{2,3}$"
          }
        }
      }
    }
  }
}
