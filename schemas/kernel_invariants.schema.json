{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:kernel_invariants:1.0",
  "title": "Kernel invariants (LBN-2.3-ADV and LBN-2.4-ADV-LMA intersection)",
  "description": "Generated by kernel_extraction.control_inventory. Every item quotes text both sources state, with spans into each.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "basis",
    "sources",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "variant",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "text",
          "scope",
          "reason",
          "reference_labels",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^k_[a-z]+_[0-9]{2}$"
          },
          "field": {
            "enum": [
              "preface",
              "ax",
              "key",
              "negative",
              "rules"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "kernel",
              "kernel_actor",
              "kernel_prop",
              "scene_reference"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reference_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "span"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
