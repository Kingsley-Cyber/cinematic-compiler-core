{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinematic-compiler:schema:motif:0.1",
  "title": "Motif (DRAFT)",
  "$comment": "DRAFT (owner O65): a placeholder contract. The repo has no motif plan or data; finding F-060 asks the owner what a motif is. Shape drafted by Claude from the callbacks of O50.",
  "description": "A reusable choreographic pattern: an ordered set of beat skeletons with roles and relative timing that a scene can instantiate, and the callbacks that echo an earlier beat (O50).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "kind",
    "card_version",
    "status",
    "name",
    "beats"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "kind": {
      "const": "motif"
    },
    "card_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "genres": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "anime",
          "live_action",
          "ugc_ad"
        ]
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "event_type",
          "actor_role",
          "at"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "actor_role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Start as a share of the motif's span."
          },
          "dur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "echoes": {
            "type": "string",
            "description": "Label of the earlier beat this one calls back (O50)."
          }
        }
      }
    }
  }
}
